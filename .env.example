# A Postgres connection string. For local development, either:
#   - run a local Postgres and create a database, e.g.
#     DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy"
#   - or create a free dev database at https://neon.tech and paste its
#     connection string here.
# In production (Vercel), set this to your Neon project's connection string
# in the Vercel project's Environment Variables — never commit a real one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy"

# Signs login session cookies. Generate your own with:
#   openssl rand -hex 32
# Changing this instantly logs everyone out (all existing session tokens
# stop verifying) — treat it as a real secret, never commit the real value.
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# SMTP credentials used to send the low-stock/expiry/payment digest email
# (see lib/mailer.ts). Works with Gmail (use an App Password, not your
# normal password: https://myaccount.google.com/apppasswords) or any other
# SMTP provider.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-pharmacy-account@gmail.com"
SMTP_PASSWORD="replace-with-an-app-password"
# Where the digest email gets sent — can be the same address as SMTP_USER.
NOTIFY_EMAIL_TO="your-pharmacy-account@gmail.com"

# Authenticates the scheduled notification digest (app/api/notifications/run) —
# Vercel Cron sends this automatically as an Authorization: Bearer header when
# this env var is set on the Vercel project. Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-32-char-hex-string"
