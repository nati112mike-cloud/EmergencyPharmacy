# Used by `docker compose up` — see README "Self-hosting with Docker".
# Copy to .env in this same directory (docker compose reads .env
# automatically) and fill in real values. Never commit the real file.

# The domain pointed at this server (its DNS A record must resolve here) —
# Caddy uses this to get you a free, automatic HTTPS certificate.
# Use "localhost" instead if you're just testing on your own machine.
DOMAIN="pharmacy.yourdomain.com"

# Postgres credentials — pick your own; these are only used inside the
# Docker network between the app and db containers, never exposed publicly.
POSTGRES_USER="pharmacy"
POSTGRES_PASSWORD="replace-with-a-real-password"
POSTGRES_DB="pharmacy"

# Signs login session cookies. Generate with: openssl rand -hex 32
# Changing this instantly logs everyone out.
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# SMTP credentials for the low-stock/expiry/payment digest email. Works with
# Gmail (use an App Password: https://myaccount.google.com/apppasswords) or
# any other SMTP provider. Leave blank to skip notifications for now.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-pharmacy-account@gmail.com"
SMTP_PASSWORD="replace-with-an-app-password"
NOTIFY_EMAIL_TO="your-pharmacy-account@gmail.com"

# Authenticates the scheduled notification digest — see the crontab entry
# in the README. Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-32-char-hex-string"
